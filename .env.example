# ============================================================
# RutAI Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# ============================================================
#
# LEYENDA:
#   [REQUERIDA]  → la app NO arranca sin este valor
#   [OPCIONAL]   → tiene un valor por defecto funcional
#
# ============================================================

# ── APP ─────────────────────────────────────────────────────
APP_NAME=RutAI Backend            # [OPCIONAL] default: "Mi API Backend"
DEBUG=False                        # [OPCIONAL] default: False — nunca True en producción

# ── BASE DE DATOS (Supabase — Transaction Pooler) ───────────
# Para obtener estos datos: Supabase → Settings → Database → Connection pooling
DB_USER=postgres.your_project_ref  # [REQUERIDA]
DB_PASSWORD=your_password_here     # [REQUERIDA]
DB_HOST=aws-0-us-east-1.pooler.supabase.com  # [REQUERIDA]
DB_PORT=6543                       # [OPCIONAL] default: 6543
DB_NAME=postgres                   # [OPCIONAL] default: postgres

# Para PostgreSQL local (desarrollo sin Supabase):
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rutai_db

# ── JWT ─────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32  # [REQUERIDA]
ALGORITHM=HS256                    # [OPCIONAL] default: HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15     # [OPCIONAL] default: 30

# ── API ─────────────────────────────────────────────────────
API_BASE_URL=https://your-domain.com  # [OPCIONAL] default: http://localhost:8000

# ── CORS ────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos.
# [OPCIONAL] defaults: http://localhost:3000, exp://127.0.0.1:19000
ALLOWED_ORIGINS=http://localhost:3000,exp://127.0.0.1:19000

# ── FIREBASE FCM ────────────────────────────────────────────
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── EXPERIMENTO GEOFENCING ──────────────────────────────────
GEOFENCE_MATCH_WINDOW_SECONDS=30   # [OPCIONAL] default: 30
